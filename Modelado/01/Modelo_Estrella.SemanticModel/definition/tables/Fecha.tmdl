table Fecha
	lineageTag: 5019fa23-a328-4f7a-bbb7-78bf47fed051
	dataCategory: Time

	measure Fecha_selection =
			VAR _min = MIN('Fecha'[Date])
			VAR _max = MAX('Fecha'[Date])
			VAR _todos = SUMMARIZE('Fecha','Fecha'[Date],'Fecha'[DayOffset],"sig",'Fecha'[DayOffset]+1,"ant",'Fecha'[DayOffset]-1)
			VAR _txt1 = CONCATENATEX(_todos,'Fecha'[Date] & " | " & 'Fecha'[DayOffset] & " | " & [sig] & " | " & [ant],",")
			VAR _enri = ADDCOLUMNS(_todos,"tieneAnterior",COUNTX(VAR _an=[ant] RETURN FILTER(_todos,'Fecha'[DayOffset]=_an),1),"tienesiguiente",COUNTX(VAR _an=[sig] RETURN FILTER(_todos,'Fecha'[DayOffset]=_an),1))
			VAR _enri2 = ADDCOLUMNS(_enri,"concatenar",IF(ISBLANK([tieneanterior]) && NOT ISBLANK([tienesiguiente]),"-",IF(ISBLANK([tienesiguiente]),",")))
			VAR _devolver = CONCATENATEX(FILTER(_enri2,NOT ISBLANK([concatenar])),'Fecha'[Date] & [concatenar],"",'Fecha'[Date])
			VAR _txt2 = CONCATENATEX(_enri2,'Fecha'[Date] & " | " & [concatenar],",",'Fecha'[Date])
			RETURN
			    _devolver
		lineageTag: fac34780-75dc-47c5-83e7-9f926bf26ace

