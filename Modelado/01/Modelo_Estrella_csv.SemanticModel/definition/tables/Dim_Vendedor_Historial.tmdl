table Dim_Vendedor_Historial
	lineageTag: d93de551-6cb0-441b-b453-585be4934db6

	column VendedorKey
		dataType: int64
		isHidden
		lineageTag: 814d7c11-2528-4ec3-a90c-0bd0dd85a855
		summarizeBy: none
		sourceColumn: VendedorKey

		annotation SummarizationSetBy = Automatic

	column NombreVendedor
		dataType: string
		lineageTag: 9d9aff14-9698-4b56-ad26-8f114e86b39a
		summarizeBy: none
		sourceColumn: NombreVendedor

