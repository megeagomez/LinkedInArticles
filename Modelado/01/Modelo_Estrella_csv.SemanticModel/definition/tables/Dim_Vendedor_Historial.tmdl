	column Hasta
		dataType: dateTime
		formatString: Long Date
		lineageTag: b2a1b4ab-9efd-42a4-8a80-5341b9d4542a
		summarizeBy: none
		sourceColumn: Hasta

		variation Variación
			isDefault
			relationship: db9a887b-5be3-447d-a437-d68099e89d44
			defaultHierarchy: LocalDateTable_65642e1a-2978-4f8c-91cd-0204f2058443.'Jerarquía de fechas'

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	partition Dim_Vendedor_Historial = m
		mode: import
		source =
			let
				Origen = Csv.Document(File.Contents(RutaCarpetaDatos & "Ventas_Plano.csv"),[Delimiter=",", Columns=23, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				EncabezadosPromovidos = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				ColumnasSeleccionadas = Table.SelectColumns(EncabezadosPromovidos, {"VendedorID","NombreVendedor","TerritorioID"}),
				SinDuplicados = Table.Distinct(ColumnasSeleccionadas),
				TipoCambiado = Table.TransformColumnTypes(SinDuplicados, {{"VendedorID", Int64.Type}, {"NombreVendedor", type text}, {"TerritorioID", Int64.Type}}),
				VendedorRenombrado = Table.RenameColumns(TipoCambiado, {{"VendedorID","VendedorKey"}}),
				PeriodoAntiguo =
					Table.AddColumn(
						Table.AddColumn(
							Table.AddColumn(
								Table.RemoveColumns(VendedorRenombrado, {"TerritorioID"}),
								"TerritorioKey", each 1, Int64.Type
							),
							"Desde", each #datetime(2005,1,1,0,0,0), type datetime
						),
						"Hasta", each #datetime(2015,12,31,0,0,0), type datetime
					),
				PeriodoActual =
					Table.RenameColumns(
						Table.AddColumn(
							Table.AddColumn(VendedorRenombrado, "Desde", each #datetime(2016,1,1,0,0,0), type datetime),
							"Hasta", each #datetime(9999,12,31,0,0,0), type datetime
						),
						{{"TerritorioID","TerritorioKey"}}
					),
				Combinado = Table.Combine({PeriodoAntiguo, PeriodoActual})
			in
				Combinado

