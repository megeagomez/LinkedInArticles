	column TerritorioKey
		dataType: int64
		lineageTag: 4c929ba1-7e10-4577-8748-614bcd89be94
		summarizeBy: count
		sourceColumn: TerritorioKey

		annotation SummarizationSetBy = Automatic

	column Desde
		dataType: dateTime
		formatString: Long Date
		lineageTag: f387d29c-325d-47a0-8e45-9e8537fdefa0
		summarizeBy: none
		sourceColumn: Desde

		variation Variación
			isDefault
			relationship: c0b5fe93-46cb-406f-98f7-682f5c0f99de
			defaultHierarchy: LocalDateTable_de4ca967-f240-4adf-a23b-ac045487bf21.'Jerarquía de fechas'

