table Ventas_Plano
	lineageTag: cc9442a9-4e26-45b5-8bb4-1906a1a53910

	/// Tabla ancha, una fila por linea de pedido; el contexto se repite en cada linea.
	measure 'Venta Total Plano' = SUM(Ventas_Plano[LineTotal])
		formatString: #,##0.00
		lineageTag: cf2a2b6b-0ae9-4910-a7aa-e204873d567f

	measure 'Clientes Unicos Plano' = DISTINCTCOUNT(Ventas_Plano[ClienteID])
		formatString: #,##0
		lineageTag: 856d5548-4676-413a-882c-1678b380bd57

	measure 'Venta Total Plano LY' = ```
			VAR FechasActuales = VALUES(Ventas_Plano[OrderDate])
			VAR FechasAnteriores = SELECTCOLUMNS(FechasActuales, "OrderDate", DATE(YEAR([OrderDate]) - 1, MONTH([OrderDate]), DAY([OrderDate])))
			RETURN
				CALCULATE(
					[Venta Total Plano],
			        all(),
					REMOVEFILTERS(Ventas_Plano[OrderDate], Ventas_Plano[Año], Ventas_Plano[Mes], Ventas_Plano[NombreMes]),
					TREATAS(FechasAnteriores, Ventas_Plano[OrderDate])
				)
			
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: bbb5775a-71c1-4d80-8563-09faefcf8c1c

		annotation PBI_FormatHint = {"currencyCulture":"es-ES"}

	measure 'Incremento YoY Plano' = [Venta Total Plano] - [Venta Total Plano LY]
		formatString: #,##0.00
		lineageTag: a2e8d4f1-7c53-4b96-9e20-1d6a5f8c3b72

	measure 'Incremento YoY % Plano' = DIVIDE([Incremento YoY Plano], [Venta Total Plano LY])
		formatString: 0.0%;-0.0%;-
		lineageTag: b3f9e5a2-8d64-4ca7-af31-2e7b6a9d4c83

	measure 'Periodo Paralelo Plano' = [Venta Total Plano LY]
		formatString: #,##0.00
		lineageTag: c4a6f8b3-9e75-4db8-b042-3f8c7b0e5d94

	measure 'Dias con compra' = DISTINCTCOUNT(Ventas_Plano[OrderDate])
		formatString: #,##0
		lineageTag: ed65f128-f4d3-486f-9e27-9fcdb7e52946

	measure 'Dias sin compra' = DATEDIFF(MIN(Ventas_Plano[OrderDate]), MAX(Ventas_Plano[OrderDate]), DAY) + 1 - [Dias con compra]
		formatString: #,##0
		lineageTag: 214a415f-fed4-459e-9cfd-186e31d47899

	measure Pedidos = DISTINCTCOUNT(Ventas_Plano[SalesOrderNumber])
		formatString: #,##0
		lineageTag: 59e7a2b4-4ed2-48e2-bab9-eafc1d0093a7

	measure Productos = DISTINCTCOUNT(Ventas_Plano[ProductoID])
		formatString: #,##0
		lineageTag: 62a7ff7f-7098-48fb-b653-596cf4425c5b

	measure Territorios = DISTINCTCOUNT(Ventas_Plano[TerritorioID])
		formatString: #,##0
		lineageTag: 0eb55301-27de-4620-85b2-1f561b7b964b

	measure 'Ticket medio' = DIVIDE([Venta Total Plano], [Pedidos])
		formatString: #,##0.00
		lineageTag: a91f7ba0-ff97-4dbb-9344-0715740c2413

	measure 'Venta Total Plano LY  (fix)' = ```
			
			 VAR anioActual=year( max(Ventas_Plano[OrderDate]))
			
			 VAR FechasAnteriores = CALENDAR(date(anioActual-1,1,1),date(anioActual-1,12,31))
			RETURN
				CALCULATE(
					[Venta Total Plano],
					REMOVEFILTERS(Ventas_Plano[OrderDate], Ventas_Plano[Año], Ventas_Plano[Mes], Ventas_Plano[NombreMes]),
					TREATAS(FechasAnteriores, Ventas_Plano[OrderDate])
				)
			```
		formatString: #,0.00\ "€";-#,0.00\ "€";#,0.00\ "€"
		lineageTag: 47f53d6c-4d4b-4422-a6a2-8b1855e5708d

		annotation PBI_FormatHint = {"currencyCulture":"es-ES"}

